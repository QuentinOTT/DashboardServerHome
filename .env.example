# ========================================
# Proxmox Dashboard - Configuration
# ========================================
# Copier ce fichier en .env et remplir les valeurs

# URL de votre serveur Proxmox (avec le port, sans slash final)
PROXMOX_HOST=https://192.168.1.100:8006

# Token d'API Proxmox
# Format: PVEAPIToken=utilisateur@pve!nom_du_token=uuid-du-token
PROXMOX_TOKEN_ID=root@pam!dashboard
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Nom du node Proxmox (visible dans l'interface Proxmox)
PROXMOX_NODE=pve

# Port du serveur backend Express
PORT=3001
